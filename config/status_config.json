{
  "stages": [
    {
      "id": "01_input_data",
      "description": "Input validation and metadata cleaning",
      "estimate_seconds": 60,
      "inputs": [
        "data/fastq/",
        "data/metadata/metadata.tsv",
        "data/metadata/metadata.csv"
      ],
      "outputs": [
        "data/metadata/metadata.cleaned.tsv",
        "01_input_data/outputs/"
      ]
    },
    {
      "id": "02_starsolo",
      "description": "STARsolo alignment (CB/UB BAM)",
      "estimate_seconds": 7200,
      "inputs": [
        "data/fastq/",
        "data/metadata/metadata.cleaned.tsv",
        "config/ref/STAR_index/",
        "config/ref/genes.gtf",
        "config/ref/whitelist.txt",
        "config/starsolo_config.json"
      ],
      "outputs": [
        "02_starsolo/outputs/artifacts/",
        "02_starsolo/outputs/metrics/"
      ]
    },
    {
      "id": "03_gatk_call",
      "description": "GATK RNA variant calling (filtered PASS VCF)",
      "estimate_seconds": 3600,
      "inputs": [
        "02_starsolo/outputs/artifacts/",
        "config/ref/genome.fa",
        "config/gatk_config.json"
      ],
      "outputs": [
        "03_gatk_call/outputs/artifacts/",
        "03_gatk_call/outputs/metrics/"
      ]
    },
    {
      "id": "04_cohort_filter",
      "description": "Cohort-common filter",
      "estimate_seconds": 900,
      "inputs": [
        "03_gatk_call/outputs/artifacts/",
        "config/cohort_filter_config.json"
      ],
      "outputs": [
        "04_cohort_filter/outputs/artifacts/",
        "04_cohort_filter/outputs/metrics/"
      ]
    },
    {
      "id": "05_variant_to_gene",
      "description": "Variant to gene annotation",
      "estimate_seconds": 600,
      "inputs": [
        "04_cohort_filter/outputs/artifacts/cohort.common.vcf.gz",
        "config/ref/genes.gtf",
        "config/variant_to_gene_config.json"
      ],
      "outputs": [
        "05_variant_to_gene/outputs/artifacts/variant_gene_long.tsv",
        "05_variant_to_gene/outputs/metrics/"
      ]
    },
    {
      "id": "06_gene_burden",
      "description": "Gene-burden matrix",
      "estimate_seconds": 600,
      "inputs": [
        "05_variant_to_gene/outputs/artifacts/variant_gene_long.tsv",
        "03_gatk_call/outputs/artifacts/",
        "config/gene_burden_config.json"
      ],
      "outputs": [
        "06_gene_burden/outputs/artifacts/gene_burden_matrix.tsv",
        "06_gene_burden/outputs/metrics/"
      ]
    },
    {
      "id": "07_ml_control_vs_disease",
      "description": "ML classification + permutation",
      "estimate_seconds": 1200,
      "inputs": [
        "06_gene_burden/outputs/artifacts/gene_burden_matrix.tsv",
        "data/metadata/metadata.cleaned.tsv",
        "config/ml_config.json"
      ],
      "outputs": [
        "07_ml_control_vs_disease/outputs/metrics/ml_metrics.tsv",
        "07_ml_control_vs_disease/outputs/metrics/permutation.tsv",
        "07_ml_control_vs_disease/outputs/artifacts/"
      ]
    },
    {
      "id": "08_cellsnp",
      "description": "cellsnp-lite per-cell allele counts",
      "estimate_seconds": 3600,
      "inputs": [
        "02_starsolo/outputs/artifacts/",
        "04_cohort_filter/outputs/artifacts/cohort.common.vcf.gz",
        "config/ref/whitelist.txt",
        "config/cellsnp_config.json"
      ],
      "outputs": [
        "08_cellsnp/outputs/artifacts/"
      ]
    },
    {
      "id": "09_cluster_aggregation",
      "description": "Cluster aggregation",
      "estimate_seconds": 900,
      "inputs": [
        "08_cellsnp/outputs/artifacts/",
        "data/metadata/cell_cluster_map.tsv",
        "config/cluster_aggregation_config.json"
      ],
      "outputs": [
        "09_cluster_aggregation/outputs/artifacts/"
      ]
    },
    {
      "id": "10_mutational_analysis",
      "description": "Mutational analysis summaries",
      "estimate_seconds": 600,
      "inputs": [
        "03_gatk_call/outputs/artifacts/",
        "config/ref/driver_genes.txt",
        "config/mutational_analysis_config.json"
      ],
      "outputs": [
        "10_mutational_analysis/outputs/metrics/mutation_burden.tsv",
        "10_mutational_analysis/outputs/metrics/mutation_signatures.tsv",
        "10_mutational_analysis/outputs/metrics/driver_counts.tsv",
        "10_mutational_analysis/outputs/metrics/pathway_enrichment.tsv"
      ]
    },
    {
      "id": "11_correlation",
      "description": "Correlation analysis",
      "estimate_seconds": 300,
      "inputs": [
        "06_gene_burden/outputs/artifacts/gene_burden_matrix.tsv",
        "09_cluster_aggregation/outputs/artifacts/",
        "10_mutational_analysis/outputs/metrics/mutation_burden.tsv",
        "10_mutational_analysis/outputs/metrics/mutation_signatures.tsv",
        "config/correlation_config.json"
      ],
      "outputs": [
        "11_correlation/outputs/metrics/correlation.tsv"
      ]
    },
    {
      "id": "12_integrated_interpretation",
      "description": "Collect report bundle",
      "estimate_seconds": 300,
      "inputs": [
        "05_variant_to_gene/outputs/",
        "06_gene_burden/outputs/",
        "07_ml_control_vs_disease/outputs/",
        "09_cluster_aggregation/outputs/",
        "10_mutational_analysis/outputs/",
        "11_correlation/outputs/"
      ],
      "outputs": [
        "for_report/",
        "12_integrated_interpretation/outputs/"
      ]
    }
  ]
}
